<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SalsaNOWSettings.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SalsaNOWSettings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    SizeChanged="Page_SizeChanged">

    <ScrollViewer
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            x:Name="PageRoot"
            Margin="0,20,0,48"
            HorizontalAlignment="Center"
            Spacing="20">

            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="Home" />

            <Grid x:Name="DeviceHeader" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="56"
                    Height="56"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="28"
                    Opacity="0.95">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="White"
                        Glyph="&#xE7F8;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="DeviceNameText"
                        FontSize="18"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="DeviceDetailsText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="CardsGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Recommended settings" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Recent and commonly used settings" />
                    <Border Style="{StaticResource SettingsChromeStyle}">
                        <StackPanel>
                            <controls:SettingsCard
                                Description="Web browser, email, file type defaults"
                                Header="Default apps"
                                IconGlyph="&#xE8A5;"
                                NavigateTag="defaults" />
                            <controls:SettingsCard
                                Description="Apps that load when this environment starts"
                                Header="Startup"
                                IconGlyph="&#xE7E8;"
                                NavigateTag="startup" />
                            <controls:SettingsCard
                                Description="Taskbar behavior, system pins"
                                Header="Taskbar"
                                IconGlyph="&#xE8A9;"
                                NavigateTag="taskbar"
                                ShowDivider="False" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="DeviceInfoBlock" Margin="0,12,0,0" Spacing="8">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Your rig info" />
                        <Border Style="{StaticResource SettingsChromeStyle}">
                            <StackPanel>
                                <StackPanel Padding="20,16,20,12" Spacing="14">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="View your rig and OS specifications" />
                                    <Grid ColumnSpacing="20" RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Processor" />
                                            <TextBlock
                                                x:Name="InfoProcessor"
                                                FontSize="14"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Name="InfoProcessorSpeed"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Installed RAM" />
                                            <TextBlock
                                                x:Name="InfoRam"
                                                FontSize="14"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Name="InfoRamUsable"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Edition" />
                                            <TextBlock
                                                x:Name="InfoEdition"
                                                FontSize="14"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="OS build" />
                                            <TextBlock
                                                x:Name="InfoOsBuild"
                                                FontSize="14"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <Rectangle
                                    Height="1"
                                    HorizontalAlignment="Stretch"
                                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <controls:SettingsCard
                                    x:Name="DeviceInfoCard"
                                    Header="More rig information"
                                    NavigateTag="about"
                                    ShowDivider="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="PersonalizeBlock" Grid.Row="0" Grid.Column="1" Spacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Personalize your rig" />
                    <Border Style="{StaticResource SettingsChromeStyle}" Padding="16,16,16,8">
                        <StackPanel>
                            <controls:WallpaperPreview
                                x:Name="HeroPreview"
                                Margin="0,0,0,14"
                                HorizontalAlignment="Left" />
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Select a theme to apply" />
                            <Grid
                                x:Name="ThemeGrid"
                                Margin="0,0,0,8"
                                ColumnSpacing="8"
                                RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="78" />
                                    <RowDefinition Height="78" />
                                </Grid.RowDefinitions>
                            </Grid>
                            <controls:SettingsCard
                                Description="Change the colors that appear in Windows and your apps"
                                Header="Choose your mode"
                                IconGlyph="&#xE793;"
                                IsClickEnabled="False"
                                ShowChevron="False">
                                <controls:SettingsCard.ActionContent>
                                    <ComboBox
                                        x:Name="ModeBox"
                                        MinWidth="128"
                                        SelectionChanged="ModeBox_SelectionChanged">
                                        <ComboBoxItem Content="Light" Tag="Light" />
                                        <ComboBoxItem Content="Dark" Tag="Dark" />
                                        <ComboBoxItem Content="Custom" Tag="Custom" />
                                    </ComboBox>
                                </controls:SettingsCard.ActionContent>
                            </controls:SettingsCard>
                            <controls:SettingsCard
                                x:Name="WindowsModeCard"
                                Description="Windows chrome, Start, and taskbar"
                                Header="Choose your default Windows mode"
                                IsClickEnabled="False"
                                ShowChevron="False"
                                Visibility="Collapsed">
                                <controls:SettingsCard.ActionContent>
                                    <ComboBox
                                        x:Name="WindowsModeBox"
                                        MinWidth="128"
                                        SelectionChanged="WindowsModeBox_SelectionChanged">
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Dark" />
                                    </ComboBox>
                                </controls:SettingsCard.ActionContent>
                            </controls:SettingsCard>
                            <controls:SettingsCard
                                x:Name="AppModeCard"
                                Description="Apps and this settings window"
                                Header="Choose your default app mode"
                                IsClickEnabled="False"
                                ShowChevron="False"
                                Visibility="Collapsed">
                                <controls:SettingsCard.ActionContent>
                                    <ComboBox
                                        x:Name="AppModeBox"
                                        MinWidth="128"
                                        SelectionChanged="AppModeBox_SelectionChanged">
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Dark" />
                                    </ComboBox>
                                </controls:SettingsCard.ActionContent>
                            </controls:SettingsCard>
                            <controls:SettingsCard
                                Header="Browse more backgrounds, colors, and themes"
                                IconGlyph="&#xE771;"
                                NavigateTag="personalization"
                                ShowDivider="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
