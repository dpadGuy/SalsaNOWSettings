<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SalsaNOWSettings.Controls.FileExplorerPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SalsaNOWSettings.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="0,0,0,8" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Width="36"
                Height="32"
                Padding="0"
                IsEnabled="False"
                ToolTipService.ToolTip="Back"
                Click="BackButton_Click">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="12" />
            </Button>
            <Button
                x:Name="ForwardButton"
                Grid.Column="1"
                Width="36"
                Height="32"
                Padding="0"
                IsEnabled="False"
                ToolTipService.ToolTip="Forward"
                Click="ForwardButton_Click">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72A;" FontSize="12" />
            </Button>
            <Button
                x:Name="UpButton"
                Grid.Column="2"
                Width="36"
                Height="32"
                Padding="0"
                IsEnabled="False"
                ToolTipService.ToolTip="Up"
                Click="UpButton_Click">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74A;" FontSize="12" />
            </Button>
            <TextBox
                x:Name="AddressBox"
                Grid.Column="3"
                VerticalAlignment="Center"
                PlaceholderText="Enter a path"
                KeyDown="AddressBox_KeyDown" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="4"
                VerticalAlignment="Center"
                PlaceholderText="Search"
                TextChanged="SearchBox_TextChanged" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8"
            Padding="0,0,0,8">
            <Button
                x:Name="NewFolderButton"
                Content="New folder"
                Click="NewFolderButton_Click" />
            <Button
                Content="Refresh"
                Click="RefreshButton_Click" />
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ListView
                    x:Name="PlacesList"
                    Padding="4"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="PlacesList_ItemClick"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileExplorerPlace">
                            <Grid
                                Padding="4,2"
                                ColumnSpacing="8"
                                Margin="{x:Bind IndentMargin}"
                                Background="{x:Bind RowBackground, Mode=OneWay}"
                                CornerRadius="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="{x:Bind Glyph}"
                                    FontSize="14" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                    <GridView
                    x:Name="FilesView"
                    Padding="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="FilesView_ItemClick"
                    DoubleTapped="FilesView_DoubleTapped"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid ItemHeight="132" ItemWidth="120" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Height" Value="132" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:FileExplorerItem">
                            <StackPanel
                                Padding="4,6"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="{x:Bind Name}">
                                <Border
                                    Width="72"
                                    Height="72"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,6"
                                    CornerRadius="4">
                                    <Grid>
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            Glyph="{x:Bind Glyph}"
                                            FontSize="32"
                                            Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                        <Image
                                            Stretch="UniformToFill"
                                            UseLayoutRounding="True"
                                            Source="{x:Bind Icon, Mode=OneWay}"
                                            Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    FontSize="12"
                                    LineHeight="16"
                                    MaxLines="2"
                                    Text="{x:Bind Name}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Padding="0,12,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="NameLabel"
                VerticalAlignment="Center"
                Text="Folder name:" />
            <TextBox
                x:Name="NameBox"
                Grid.Column="1"
                VerticalAlignment="Center"
                IsReadOnly="True" />
            <ComboBox
                x:Name="TypeCombo"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                IsEnabled="False" />
            <StackPanel
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="CancelButton"
                    MinWidth="88"
                    Content="Cancel"
                    Click="CancelButton_Click" />
                <Button
                    x:Name="ConfirmButton"
                    MinWidth="88"
                    Content="Open"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
