<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SalsaNOWSettings.Controls.KnobControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="88"
    Height="88">

    <Grid
        x:Name="HitArea"
        PointerPressed="HitArea_PointerPressed"
        PointerMoved="HitArea_PointerMoved"
        PointerReleased="HitArea_PointerReleased"
        PointerCanceled="HitArea_PointerReleased"
        PointerCaptureLost="HitArea_PointerReleased">
        <Ellipse
            Width="76"
            Height="76"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
            StrokeThickness="1" />

        <Ellipse
            Width="54"
            Height="54"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

        <Rectangle
            x:Name="Indicator"
            Width="3"
            Height="20"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Fill="{ThemeResource AccentFillColorDefaultBrush}"
            RadiusX="1.5"
            RadiusY="1.5"
            RenderTransformOrigin="0.5,1.7">
            <Rectangle.RenderTransform>
                <RotateTransform x:Name="IndicatorRotate" Angle="-135" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <TextBlock
            x:Name="ValueLabel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="SemiBold" />
    </Grid>
</UserControl>
