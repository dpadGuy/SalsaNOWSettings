<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SalsaNOWSettings.Controls.WallpaperPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="236"
    Height="158">

    <Border
        Padding="10"
        Background="#1A1A1A"
        CornerRadius="16">
        <Grid>
            <Border x:Name="PreviewClip" CornerRadius="8" Background="#111">
                <Border x:Name="PreviewLayer" CornerRadius="8" />
            </Border>
            <Border
                Width="100"
                Height="65"
                Margin="0,0,6,60"
                Padding="10,9,10,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="#282828"
                CornerRadius="6">
                <Grid>
                    <StackPanel Spacing="4" VerticalAlignment="Top">
                        <Border Height="2" Width="36" HorizontalAlignment="Left" Background="#D6DEEA" CornerRadius="1" />
                        <Border Height="2" Width="44" HorizontalAlignment="Left" Background="#D6DEEA" CornerRadius="1" />
                        <Border Height="2" Width="28" HorizontalAlignment="Left" Background="#D6DEEA" CornerRadius="1" />
                    </StackPanel>
                    <Border
                        Width="22"
                        Height="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="#B8D4F0"
                        CornerRadius="3" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
