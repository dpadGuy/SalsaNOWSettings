<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SalsaNOWSettings.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="RootGrid"
            MinHeight="30"
            Padding="20,14"
            Background="Transparent"
            CornerRadius="4"
            ColumnSpacing="16"
            PointerEntered="RootGrid_PointerEntered"
            PointerExited="RootGrid_PointerExited"
            PointerPressed="RootGrid_PointerPressed"
            PointerReleased="RootGrid_PointerReleased"
            Tapped="RootGrid_Tapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                x:Name="IconElement"
                VerticalAlignment="Center"
                FontSize="20"
                Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                Visibility="{x:Bind IconVisibility(IconGlyph), Mode=OneWay}" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    FontSize="14"
                    Text="{x:Bind Header, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Description, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind DescriptionVisibility(Description), Mode=OneWay}" />
            </StackPanel>

            <ContentPresenter
                x:Name="ActionPresenter"
                Grid.Column="2"
                VerticalAlignment="Center"
                Content="{x:Bind ActionContent, Mode=OneWay}" />

            <FontIcon
                Grid.Column="3"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE76C;"
                Visibility="{x:Bind ChevronVisibility(ShowChevron), Mode=OneWay}" />
        </Grid>

        <Rectangle
            Grid.Row="1"
            Height="1"
            Margin="0,0,0,0"
            HorizontalAlignment="Stretch"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
            Visibility="{x:Bind ChevronVisibility(ShowDivider), Mode=OneWay}" />
    </Grid>
</UserControl>
