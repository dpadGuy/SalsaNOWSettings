<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SalsaNOWSettings.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SalsaNOWSettings">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#4CC2FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#4CC2FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#4CC2FF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#4CC2FF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="SettingsChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="4,2" />
            </Style>

            <Style x:Key="WallpaperTileStyle" TargetType="Border">
                <Setter Property="Width" Value="96" />
                <Setter Property="Height" Value="58" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="WallpaperRecentTileStyle" TargetType="Border" BasedOn="{StaticResource WallpaperTileStyle}">
                <Setter Property="Width" Value="148" />
                <Setter Property="Height" Value="84" />
            </Style>

            <Style x:Key="WallpaperHomeTileStyle" TargetType="Border">
                <Setter Property="Height" Value="78" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
